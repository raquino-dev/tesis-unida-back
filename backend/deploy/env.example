# Claves criptográficas independientes, mínimo 32 bytes cada una.
JWT_SIGNING_KEY=reemplazar-clave-jwt
ARCHIVOS_SIGNING_KEY=reemplazar-clave-firma-archivos
TOKEN_PUSH_ENCRYPTION_KEY=reemplazar-clave-cifrado-token-push

# MinIO sólo para desarrollo local.
