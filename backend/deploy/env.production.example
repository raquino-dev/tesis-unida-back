# Conexiones Supabase con roles distintos. Incluya SSL Mode=Require.
MIGRATOR_DATABASE_URL=Host=db.PROJECT.supabase.co;Port=5432;Database=postgres;Username=finanzas_migrador;Password=CAMBIAR;SSL Mode=Require
API_DATABASE_URL=Host=db.PROJECT.supabase.co;Port=5432;Database=postgres;Username=finanzas_api;Password=CAMBIAR;SSL Mode=Require
WORKER_DATABASE_URL=Host=db.PROJECT.supabase.co;Port=5432;Database=postgres;Username=finanzas_worker;Password=CAMBIAR;SSL Mode=Require

JWT_SIGNING_KEY=GENERAR_48_BYTES_O_MAS
ARCHIVOS_SIGNING_KEY=GENERAR_OTRA_CLAVE
TOKEN_PUSH_ENCRYPTION_KEY=GENERAR_OTRA_CLAVE
DATA_PROTECTION_CERTIFICATE_PASSWORD=CONTRASENA_DEL_PFX

PUBLIC_API_URL=https://api.example.com
PUBLIC_APP_URL=https://app.example.com
REVERSE_PROXY_IP=127.0.0.1

AWS_REGION=us-east-1
SES_FROM_ADDRESS=no-reply@example.com
# En un VPS use credenciales temporales/rol cuando sea posible.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

GOOGLE_PLAY_PACKAGE_NAME=com.tesis.finanzasinteligentes
GOOGLE_PLAY_RTDN_AUDIENCE=https://api.example.com/api/v1/webhooks/google-play/rtdn
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=pubsub-push@example-project.iam.gserviceaccount.com
GOOGLE_PLAY_PRODUCT_MONTHLY=premium_monthly
GOOGLE_PLAY_PRODUCT_YEARLY=premium_yearly
