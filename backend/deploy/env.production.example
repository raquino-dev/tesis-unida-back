# Arquitectura del piloto: todos los servicios regionales se fijan en
# North Virginia/us-east-1. No cambie la región sin reevaluar Textract.

# Supabase Pro North Virginia. API y Worker usan Supavisor session mode
# (puerto 5432). El migrador usa la conexión directa IPv6.
# Descargue el certificado raíz desde Supabase y use VerifyFull.
MIGRATOR_DATABASE_URL=Host=db.PROJECT.supabase.co;Port=5432;Database=postgres;Username=finanzas_migrador;Password=CAMBIAR;SSL Mode=VerifyFull;Root Certificate=/run/secrets/supabase-ca.crt;Maximum Pool Size=2
API_DATABASE_URL=Host=aws-0-us-east-1.pooler.supabase.com;Port=5432;Database=postgres;Username=finanzas_api.PROJECT;Password=CAMBIAR;SSL Mode=VerifyFull;Root Certificate=/run/secrets/supabase-ca.crt;Maximum Pool Size=15
WORKER_DATABASE_URL=Host=aws-0-us-east-1.pooler.supabase.com;Port=5432;Database=postgres;Username=finanzas_worker.PROJECT;Password=CAMBIAR;SSL Mode=VerifyFull;Root Certificate=/run/secrets/supabase-ca.crt;Maximum Pool Size=5

# El pipeline reemplaza estas etiquetas por imágenes inmutables con el SHA.
API_IMAGE=finanzas-api:pilot
WORKER_IMAGE=finanzas-worker:pilot
MIGRATOR_IMAGE=finanzas-migrator:pilot

JWT_SIGNING_KEY=GENERAR_48_BYTES_O_MAS
ARCHIVOS_SIGNING_KEY=GENERAR_OTRA_CLAVE
TOKEN_PUSH_ENCRYPTION_KEY=GENERAR_OTRA_CLAVE
DATA_PROTECTION_CERTIFICATE_PASSWORD=CONTRASENA_DEL_PFX

PUBLIC_API_URL=https://api.example.com
PUBLIC_APP_URL=finanzasinteligentes://app

# IAM de mínimo privilegio. Lightsail no inyecta estas credenciales al
# contenedor; el archivo .env.production debe pertenecer a root y tener modo 600.
API_AWS_ACCESS_KEY_ID=
API_AWS_SECRET_ACCESS_KEY=
WORKER_AWS_ACCESS_KEY_ID=
WORKER_AWS_SECRET_ACCESS_KEY=
S3_DOCUMENT_BUCKET=finanzas-inteligentes-documentos
S3_DOCUMENT_PREFIX=piloto
SES_FROM_ADDRESS=no-reply@example.com
SES_FROM_NAME=Finanzas Inteligentes

FIREBASE_PROJECT_ID=example-firebase-project

GOOGLE_PLAY_PACKAGE_NAME=com.tesis.finanzasinteligentes
GOOGLE_PLAY_RTDN_AUDIENCE=https://api.example.com/api/v1/webhooks/google-play/rtdn
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=pubsub-push@example-project.iam.gserviceaccount.com
GOOGLE_PLAY_PRODUCT_MONTHLY=premium_monthly
GOOGLE_PLAY_PRODUCT_YEARLY=premium_yearly
