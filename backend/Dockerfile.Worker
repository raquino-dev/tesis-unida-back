FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /repo
COPY backend/ backend/
RUN dotnet restore backend/src/FinanzasInteligentes.Worker/FinanzasInteligentes.Worker.csproj
RUN dotnet publish backend/src/FinanzasInteligentes.Worker/FinanzasInteligentes.Worker.csproj \
    --no-restore -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app .
RUN mkdir -p /app/private-storage \
    && chown -R $APP_UID /app/private-storage
USER $APP_UID
ENTRYPOINT ["dotnet", "FinanzasInteligentes.Worker.dll"]
