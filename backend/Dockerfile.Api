FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /repo
COPY backend/ backend/
COPY docs/api/openapi.yaml docs/api/openapi.yaml
RUN dotnet restore backend/src/FinanzasInteligentes.Api/FinanzasInteligentes.Api.csproj
RUN dotnet publish backend/src/FinanzasInteligentes.Api/FinanzasInteligentes.Api.csproj \
    --no-restore -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgssapi-krb5-2 curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app .
RUN mkdir -p /app/private-storage /app/data-protection-keys \
    && chown -R $APP_UID /app/private-storage /app/data-protection-keys
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "FinanzasInteligentes.Api.dll"]
