    (proveedor, referencia_externa_hash, tipo) [name: 'ix_transacciones_proveedor_referencia_externa_hash_tipo', unique]
  }
}

Ref fk_avisos_suscripciones_suscripcion_id: suscripciones.avisos.suscripcion_id > suscripciones.suscripciones.id [delete: cascade]
