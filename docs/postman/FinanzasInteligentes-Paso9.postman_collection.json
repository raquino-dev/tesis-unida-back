{
  "info": {
    "_postman_id": "8b53a465-6bc4-4f72-b0bc-e4b988fd56fb",
    "name": "Finanzas Inteligentes - Prueba completa Paso 9",
    "description": "Prueba local encadenada: salud, registro, inicio de sesión, cuenta, categoría, ingreso, gasto, movimientos, tablero y reporte. Ejecute la colección en orden con la API disponible en http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Comprobar API",
      "item": [
        {
          "name": "Salud - proceso vivo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/salud/vivo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "salud",
                "vivo"
              ]
            },
            "description": "Comprueba que el proceso de la API está ejecutándose."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La API está viva', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Salud - PostgreSQL listo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/salud/listo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "salud",
                "listo"
              ]
            },
            "description": "Comprueba que la API puede conectarse a PostgreSQL."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PostgreSQL está disponible', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Identidad",
      "item": [
        {
          "name": "Registrar usuario de prueba",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const unique = `${Date.now()}-${Math.floor(Math.random() * 100000)}`;",
                  "pm.collectionVariables.set('testEmail', `prueba.${unique}@example.com`);",
                  "pm.collectionVariables.set('currentDate', new Date().toISOString().slice(0, 10));",
                  "['userId', 'accessToken', 'refreshToken', 'accountId', 'categoryId', 'incomeId', 'expenseId'].forEach(function (name) {",
                  "    pm.collectionVariables.unset(name);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Usuario creado', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.expect(json.id, 'El usuario debe devolver id').to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('userId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{testEmail}}\",\n  \"nombre\": \"Usuario Postman\",\n  \"contrasena\": \"{{testPassword}}\",\n  \"moneda\": \"PYG\",\n  \"idioma\": \"es\",\n  \"zonaHoraria\": \"America/Asuncion\",\n  \"aceptaTerminos\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apiBaseUrl}}/usuarios",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Genera un correo diferente en cada ejecución y registra un usuario."
          },
          "response": []
        },
        {
          "name": "Iniciar sesión",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sesión creada', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.expect(json.accessToken, 'La sesión debe devolver accessToken').to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{testEmail}}\",\n  \"contrasena\": \"{{testPassword}}\",\n  \"dispositivo\": {\n    \"identificador\": \"postman-local-01\",\n    \"nombre\": \"Postman local\",\n    \"plataforma\": \"windows\",\n    \"versionSistema\": \"11\",\n    \"versionAplicacion\": \"0.1.0\"\n  },\n  \"recordarDispositivo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apiBaseUrl}}/sesiones",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "sesiones"
              ]
            },
            "description": "Inicia sesión y guarda accessToken y refreshToken como variables de colección."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Preparar finanzas",
      "item": [
