              "raw": "{\n  \"nombre\": \"Prueba Postman\",\n  \"tipo\": \"ambos\",\n  \"icono\": \"test\",\n  \"color\": \"#10B981\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
