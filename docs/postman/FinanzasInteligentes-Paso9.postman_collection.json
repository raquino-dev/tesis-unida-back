    {
      "name": "05 - Consultar resultados",
      "item": [
        {
          "name": "Listar movimientos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Movimientos disponibles', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "const data = Array.isArray(json) ? json : (json.datos || []);",
                  "pm.expect(data.length, 'Deben existir al menos ingreso y gasto').to.be.at.least(2);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/movimientos",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "movimientos"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Consultar tablero privado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tablero calculado', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.expect(json.ambito).to.eql('privado');",
                  "pm.expect(json.ingresos).to.eql(2000000);",
                  "pm.expect(json.gastos).to.eql(300000);",
                  "pm.expect(json.balance).to.eql(1700000);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/tableros-financieros?ambito=privado",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "tableros-financieros"
              ],
              "query": [
                {
                  "key": "ambito",
                  "value": "privado"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Consultar reporte mensual",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reporte calculado', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.expect(json.ambito).to.eql('privado');",
                  "pm.expect(json.rango).to.eql('mes');",
                  "pm.expect(json.ingresos).to.eql(2000000);",
                  "pm.expect(json.gastos).to.eql(300000);",
                  "pm.expect(json.balance).to.eql(1700000);",
                  "pm.expect(json.distribucion).to.be.an('array').that.is.not.empty;"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/reportes-financieros?rango=mes",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "reportes-financieros"
              ],
              "query": [
                {
