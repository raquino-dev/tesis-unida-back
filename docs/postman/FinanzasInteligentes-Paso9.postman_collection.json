              "raw": "{\n  \"ambito\": \"privado\",\n  \"cuentaId\": \"{{accountId}}\",\n  \"tipo\": \"gasto\",\n  \"monto\": 300000,\n  \"descripcion\": \"Gasto generado desde Postman\",\n  \"fecha\": \"{{currentDate}}\",\n  \"categoriaIds\": [\"{{categoryId}}\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
